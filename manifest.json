{
  "manifest_version": 2,
  "name": "Selection Scope",
  "short_name": "Scope",
  "version": "1.0.0",
  "description": "Select any region of a webpage, then rotate and zoom it live — works with video and animations.",

  "browser_specific_settings": {
    "gecko": {
      "id": "selection-scope@example.com",
      "strict_min_version": "109.0"
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "browser_action": {
    "default_title": "Selection Scope — click to select a region",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "permissions": [
    "activeTab"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  }
}
